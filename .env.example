# Copy to .env and fill in. .env is gitignored.

# console.groq.com -- free tier is enough
GROQ_API_KEY=

# console.cloud.google.com -- enable "Places API (New)", not the legacy one
GOOGLE_PLACES_API_KEY=

# Optional. Unset means a local SQLite file (dealstracker.db) next to db.py,
# which is the right choice for development. Set it to a PostgreSQL URL to
# keep saved deals and price history somewhere that survives a redeploy --
# on Streamlit Cloud the filesystem is wiped on every restart, so a SQLite
# file there resets constantly. Supabase's pooled connection string works:
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=
